rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isPermittedType() {
      return request.resource.contentType.matches('^(image/(jpeg|png|webp)|video/(mp4|webm)|application/pdf).*$');
    }

    function isUnderMaxSize() {
      return request.resource.size <= 15 * 1024 * 1024;
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'rohantarke07@gmail.com' ||
        request.auth.token.email == 'admin@civicbridge.gov.in' ||
        (request.auth.token.role != null && request.auth.token.role == 'super_admin')
      );
    }

    function isAuthorizedOfficial() {
      return isSuperAdmin() || (
        isSignedIn() &&
        request.auth.token.role != null &&
        (request.auth.token.role in ['officer', 'department_admin'])
      );
    }

    // Citizen and submitter evidence uploads:
    // Partitioned by citizen UID: evidence/{userId}/{fileName}
    match /evidence/{userId}/{fileName} {
      // Citizen can only write to their own directory, with MIME and size constraints
      allow write: if isOwner(userId) && isPermittedType() && isUnderMaxSize();
      
      // Read access: only the owner citizen, or authorized officials reviewing the docket
      allow read: if isOwner(userId) || isAuthorizedOfficial();
      
      // Delete access: only owner or super admin
      allow delete: if isOwner(userId) || isSuperAdmin();
    }

    // Resolution evidence from field officers:
    // Partitioned by officer UID: resolutions/{userId}/{fileName}
    match /resolutions/{userId}/{fileName} {
      allow write: if isOwner(userId) && isPermittedType() && isUnderMaxSize();
      allow read: if isOwner(userId) || isAuthorizedOfficial();
      allow delete: if isOwner(userId) || isSuperAdmin();
    }

    // Default safety deny
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
