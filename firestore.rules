rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // GLOBAL REUSABLE HARDENED HELPERS (PILLARS)
    // ==========================================

    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Role verification against database user record
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasUserDoc() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isSuperAdminEmail() {
      return isSignedIn() && (
        request.auth.token.email == 'rohantarke07@gmail.com' ||
        request.auth.token.email == 'admin@civicbridge.gov.in'
      );
    }

    function isSuperAdmin() {
      return isSuperAdminEmail() || (
        hasUserDoc() && getUserData().role == 'super_admin'
      );
    }

    function isDeptAdmin() {
      return isSuperAdmin() || (
        hasUserDoc() && getUserData().role == 'department_admin'
      );
    }

    function isOfficer() {
      return isSuperAdmin() || isDeptAdmin() || (
        hasUserDoc() && getUserData().role == 'officer'
      );
    }

    function isExpert() {
      return isSuperAdmin() || (
        hasUserDoc() && getUserData().role == 'expert'
      );
    }

    // ==========================================
    // VALIDATION BLUEPRINTS
    // ==========================================

    function isValidUser(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 120 &&
             data.role in ['citizen', 'officer', 'department_admin', 'super_admin', 'expert'] &&
             (!('email' in data) || (data.email is string && data.email.size() <= 150)) &&
             (!('phone' in data) || (data.phone is string && data.phone.size() <= 30)) &&
             (!('department' in data) || (data.department is string && data.department.size() <= 150)) &&
             (!('designation' in data) || (data.designation is string && data.designation.size() <= 150)) &&
             (!('wardOrDistrict' in data) || (data.wardOrDistrict is string && data.wardOrDistrict.size() <= 100));
    }

    function isValidProblem(data) {
      return data.id is string && isValidId(data.id) &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
             data.description is string && data.description.size() > 0 && data.description.size() <= 4000 &&
             data.category is string && data.category.size() <= 100 &&
             data.status in [
               'Submitted', 'Under Review', 'Assigned', 'In Progress',
               'Awaiting Information', 'Resolution Submitted',
               'Citizen Verification', 'Resolved', 'Closed', 'Disputed', 'Reopened', 'Rejected'
             ] &&
             data.evidence is list && data.evidence.size() <= 15 &&
             data.timeline is list && data.timeline.size() <= 50 &&
             (!('reporterUid' in data) || (data.reporterUid is string && data.reporterUid.size() <= 128));
    }

    function isValidInnovation(data) {
      return data.id is string && isValidId(data.id) &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
             data.description is string && data.description.size() > 0 && data.description.size() <= 5000 &&
             data.category is string && data.category.size() <= 100 &&
             data.stage in ['Proposed', 'Under Review', 'Community Discussion', 'Pilot Approved', 'Implemented'] &&
             data.votes is number && data.votes >= 0 &&
             data.voters is list && data.voters.size() <= 5000 &&
             data.reviews is list && data.reviews.size() <= 50 &&
             data.comments is list && data.comments.size() <= 200;
    }

    function isValidConsultation(data) {
      return data.id is string && isValidId(data.id) &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 250 &&
             data.department is string && data.department.size() <= 150 &&
             data.status in ['Active', 'Closing Soon', 'Closed for Review', 'Policy Adopted', 'Under Deliberation', 'Concluded', 'Draft'] &&
             data.questions is list && data.questions.size() <= 30 &&
             data.totalResponses is number && data.totalResponses >= 0 &&
             data.voters is list && data.voters.size() <= 5000;
    }

    // ==========================================
    // GLOBAL DEFAULT CATCH-ALL (SAFETY NET)
    // ==========================================
    match /{document=**} {
      allow read, write: if false;
    }

    // ==========================================
    // 1. USERS COLLECTION (STRICT ROLE PROTECTION)
    // ==========================================
    match /users/{userId} {
      // User can read their own profile; admins and officers can read profiles for dispatch/coordination
      allow get: if isValidId(userId) && (isOwner(userId) || isOfficer());
      allow list: if isDeptAdmin();

      // Only self-registration as citizen OR admin provisioning
      allow create: if isValidId(userId) && isSignedIn() &&
                    request.auth.uid == userId &&
                    isValidUser(incoming()) &&
                    (incoming().role == 'citizen' || isSuperAdmin());

      // Profile updates: Citizens can NEVER update their own role
      allow update: if isValidId(userId) && isSignedIn() && isValidUser(incoming()) && (
        isSuperAdmin() ||
        (
          isDeptAdmin() && incoming().role in ['officer', 'expert']
        ) ||
        (
          isOwner(userId) &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'name', 'phone', 'email', 'avatar', 'photoURL', 'wardOrDistrict', 'updatedAt'
          ])
        )
      );

      allow delete: if isValidId(userId) && isSuperAdmin();
    }

    // ==========================================
    // 2. PROBLEMS COLLECTION (PRIVATE CASE REPOSITORY)
    // ==========================================
    match /problems/{problemId} {
      // Citizens can only read their own private cases; officers read assigned/department cases; super admins read all
      allow get: if isValidId(problemId) && isSignedIn() && (
        isSuperAdmin() ||
        isDeptAdmin() ||
        (isOfficer() && (
          existing().assignedOfficer.id == request.auth.uid ||
          existing().assignedOfficer.email == request.auth.token.email
        )) ||
        existing().reporterUid == request.auth.uid
      );

      allow list: if isSignedIn() && (
        isSuperAdmin() ||
        isDeptAdmin() ||
        isOfficer() ||
        (request.query.limit <= 100)
      );

      // Authenticated citizen lodges complaint
      allow create: if isValidId(problemId) && isSignedIn() &&
                    isValidProblem(incoming()) &&
                    incoming().reporterUid == request.auth.uid;

      // Role-delimited updates
      allow update: if isValidId(problemId) && isSignedIn() && isValidProblem(incoming()) && (
        // Super Admin full authority
        isSuperAdmin() ||
        // Department Admin assigning officers or updating department workflow
        (
          isDeptAdmin() &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'status', 'department', 'assignedOfficer', 'deadline', 'priority',
            'internalNotes', 'timeline', 'updatedAt'
          ])
        ) ||
        // Field Officer submitting ground progress or photo resolution evidence
        (
          isOfficer() &&
          (existing().assignedOfficer.id == request.auth.uid || existing().assignedOfficer.email == request.auth.token.email) &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'status', 'resolutionEvidence', 'timeline', 'internalNotes', 'updatedAt'
          ])
        ) ||
        // Reporting Citizen submitting verification or dispute of resolution
        (
          existing().reporterUid == request.auth.uid &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'citizenVerification', 'status', 'timeline', 'updatedAt'
          ])
        )
      );

      allow delete: if isValidId(problemId) && isSuperAdmin();
    }

    // ==========================================
    // 3. PUBLIC PROBLEMS (SANITIZED TRANSPARENCY MIRROR)
    // No citizen phone, email, internal notes, or private evidence
    // ==========================================
    match /public_problems/{problemId} {
      allow get, list: if true;

      allow create, update: if isSignedIn() &&
                            (!('citizenPhone' in incoming())) &&
                            (!('reporterEmail' in incoming())) &&
                            (!('internalNotes' in incoming()));

      allow delete: if isSuperAdmin();
    }

    // ==========================================
    // 4. INNOVATIONS COLLECTION (COMMUNITY CO-CREATION)
    // ==========================================
    match /innovations/{innovationId} {
      allow get, list: if true; // Public innovation co-creation

      allow create: if isValidId(innovationId) && isSignedIn() &&
                    isValidInnovation(incoming()) &&
                    incoming().submitterUid == request.auth.uid &&
                    incoming().votes == 0 &&
                    incoming().voters.size() == 0;

      allow update: if isValidId(innovationId) && isSignedIn() && isValidInnovation(incoming()) && (
        isSuperAdmin() ||
        // Citizen Submitter editing text/details
        (
          existing().submitterUid == request.auth.uid &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'title', 'description', 'problemAddressed', 'expectedImpact',
            'targetWard', 'costEstimate', 'timelineEstimate', 'attachments', 'updatedAt'
          ])
        ) ||
        // Tamper-proof voting: exactly 1 vote toggle per authenticated citizen
        (
          incoming().diff(existing()).affectedKeys().hasOnly(['votes', 'voters', 'updatedAt']) &&
          (
            (incoming().voters.hasAll([request.auth.uid]) && incoming().votes == existing().votes + 1) ||
            (!incoming().voters.hasAll([request.auth.uid]) && incoming().votes == existing().votes - 1)
          )
        ) ||
        // Comments: appending citizen or expert discussions
        (
          incoming().diff(existing()).affectedKeys().hasOnly(['comments', 'updatedAt'])
        ) ||
        // Advisory expert committee evaluation
        (
          isExpert() &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'reviews', 'feasibilityScore', 'stage', 'pilotDetails', 'grantAmount', 'recognitionBadge', 'updatedAt'
          ])
        )
      );

      allow delete: if isValidId(innovationId) && (isSuperAdmin() || (isSignedIn() && existing().submitterUid == request.auth.uid));

      // Voter subcollection for one-vote audit tracking
      match /votes/{voterUid} {
        allow read, write: if isSignedIn() && request.auth.uid == voterUid;
      }
    }

    // ==========================================
    // 5. CONSULTATIONS COLLECTION (PUBLIC POLICY POLLING)
    // ==========================================
    match /consultations/{consultationId} {
      allow get, list: if true; // Public civic consultations

      allow create: if isValidId(consultationId) && isDeptAdmin() && isValidConsultation(incoming());

      allow update: if isValidId(consultationId) && isSignedIn() && isValidConsultation(incoming()) && (
        isDeptAdmin() ||
        // Citizen submitting survey answers
        (
          incoming().diff(existing()).affectedKeys().hasOnly([
            'questions', 'voters', 'totalResponses', 'updatedAt'
          ]) &&
          incoming().voters.hasAll([request.auth.uid])
        )
      );

      allow delete: if isValidId(consultationId) && isSuperAdmin();
    }

    // ==========================================
    // 6. AUDIT LOGS (ADMINISTRATIVE TRACEABILITY)
    // ==========================================
    match /audit_logs/{logId} {
      allow read: if isDeptAdmin();
      allow create: if isSignedIn();
      allow update, delete: if false; // Immutable audit trail
    }

    // ==========================================
    // 7. CONNECTION TEST
    // ==========================================
    match /_connection_test/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }
  }
}
